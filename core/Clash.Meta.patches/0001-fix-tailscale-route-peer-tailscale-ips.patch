From 8d0cd9a9f5554dba37db1a44fd67baffddb84899 Mon Sep 17 00:00:00 2001
From: eya46 <admin@eya46.com>
Date: Tue, 21 Apr 2026 09:05:39 +0800
Subject: [PATCH] fix(tailscale): route peer Tailscale IPs through tsnet
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

peerRoutes was stripping the peer's own /32 (and /128) prefixes from the
route table: when PrimaryRoutes was set it returned only those, and when
falling back to AllowedIPs it explicitly dropped host prefixes whose
address matched an entry in peer.TailscaleIPs. Since mihomo has no
tailscale TUN of its own, dropping those prefixes meant direct
connections to peer 100.64.x.x (or fd7a::/48 v6) addresses never matched
a tailscale route, fell through to the regular rule chain, and were
black-holed at the real internet — hence the 'no response' on IP and
the upstream 503 on magic-DNS names that resolved to peer IPs.

Always include the peer's TailscaleIPs as host prefixes and add
PrimaryRoutes / AllowedIPs on top, deduplicating by prefix. Exit-node
default routes still get filtered upstream by collectRoutes.
---
 component/tailscale/manager.go      | 41 +++++++++++++------
 component/tailscale/manager_test.go | 61 +++++++++++++++++++++++++++++
 2 files changed, 90 insertions(+), 12 deletions(-)

diff --git a/component/tailscale/manager.go b/component/tailscale/manager.go
index 8e48e4f2..94a62e3d 100644
--- a/component/tailscale/manager.go
+++ b/component/tailscale/manager.go
@@ -1310,25 +1310,42 @@ func collectRoutes(status *ipnstate.Status) []netip.Prefix {
 }
 
 func peerRoutes(peer *ipnstate.PeerStatus) []netip.Prefix {
-	if peer.PrimaryRoutes != nil && !peer.PrimaryRoutes.IsNil() {
-		return append([]netip.Prefix(nil), peer.PrimaryRoutes.AsSlice()...)
+	seen := map[netip.Prefix]struct{}{}
+	var routes []netip.Prefix
+	add := func(prefix netip.Prefix) {
+		if !prefix.IsValid() {
+			return
+		}
+		if _, ok := seen[prefix]; ok {
+			return
+		}
+		seen[prefix] = struct{}{}
+		routes = append(routes, prefix)
 	}
 
-	if peer.AllowedIPs == nil || peer.AllowedIPs.IsNil() {
-		return nil
+	// Always route the peer's own Tailscale IPs through tsnet. mihomo has no
+	// tailscale TUN of its own, so the /32 (or /128) per-peer prefixes must
+	// be in the route table for direct peer-to-peer connections to match.
+	// Otherwise traffic to 100.64.x.x falls through to the regular rule
+	// chain (usually DIRECT) and is black-holed at the real internet.
+	for _, addr := range peer.TailscaleIPs {
+		if !addr.IsValid() {
+			continue
+		}
+		add(netip.PrefixFrom(addr, addr.BitLen()))
 	}
 
-	tailscaleIPs := map[netip.Addr]struct{}{}
-	for _, addr := range peer.TailscaleIPs {
-		tailscaleIPs[addr] = struct{}{}
+	if peer.PrimaryRoutes != nil && !peer.PrimaryRoutes.IsNil() {
+		for _, prefix := range peer.PrimaryRoutes.AsSlice() {
+			add(prefix)
+		}
+		return routes
 	}
 
-	var routes []netip.Prefix
-	for _, prefix := range peer.AllowedIPs.AsSlice() {
-		if _, ok := tailscaleIPs[prefix.Addr()]; ok && prefix.Bits() == prefix.Addr().BitLen() {
-			continue
+	if peer.AllowedIPs != nil && !peer.AllowedIPs.IsNil() {
+		for _, prefix := range peer.AllowedIPs.AsSlice() {
+			add(prefix)
 		}
-		routes = append(routes, prefix)
 	}
 	return routes
 }
diff --git a/component/tailscale/manager_test.go b/component/tailscale/manager_test.go
index 7d40552c..162423b6 100644
--- a/component/tailscale/manager_test.go
+++ b/component/tailscale/manager_test.go
@@ -17,6 +17,7 @@ import (
 	"tailscale.com/ipn"
 	"tailscale.com/ipn/ipnstate"
 	"tailscale.com/tailcfg"
+	"tailscale.com/types/views"
 )
 
 type fakeServer struct {
@@ -824,6 +825,66 @@ func BenchmarkMatch(b *testing.B) {
 	}
 }
 
+func TestPeerRoutesIncludesPeerTailscaleIPs(t *testing.T) {
+	peer := &ipnstate.PeerStatus{
+		TailscaleIPs: []netip.Addr{
+			netip.MustParseAddr("100.64.0.5"),
+			netip.MustParseAddr("fd7a:115c:a1e0::5"),
+		},
+		AllowedIPs: ptrSliceView([]netip.Prefix{
+			netip.MustParsePrefix("100.64.0.5/32"),
+			netip.MustParsePrefix("fd7a:115c:a1e0::5/128"),
+			netip.MustParsePrefix("192.168.1.0/24"),
+		}),
+	}
+
+	routes := peerRoutes(peer)
+	if !containsPrefix(routes, netip.MustParsePrefix("100.64.0.5/32")) {
+		t.Fatalf("expected peer /32 in routes, got %v", routes)
+	}
+	if !containsPrefix(routes, netip.MustParsePrefix("fd7a:115c:a1e0::5/128")) {
+		t.Fatalf("expected peer /128 in routes, got %v", routes)
+	}
+	if !containsPrefix(routes, netip.MustParsePrefix("192.168.1.0/24")) {
+		t.Fatalf("expected subnet route in routes, got %v", routes)
+	}
+}
+
+func TestPeerRoutesPreservesTailscaleIPsWithPrimaryRoutes(t *testing.T) {
+	peer := &ipnstate.PeerStatus{
+		TailscaleIPs: []netip.Addr{netip.MustParseAddr("100.64.0.7")},
+		PrimaryRoutes: ptrSliceView([]netip.Prefix{
+			netip.MustParsePrefix("10.1.0.0/16"),
+		}),
+		AllowedIPs: ptrSliceView([]netip.Prefix{
+			netip.MustParsePrefix("100.64.0.7/32"),
+			netip.MustParsePrefix("10.1.0.0/16"),
+		}),
+	}
+
+	routes := peerRoutes(peer)
+	if !containsPrefix(routes, netip.MustParsePrefix("100.64.0.7/32")) {
+		t.Fatalf("expected peer /32 to be present when PrimaryRoutes is set, got %v", routes)
+	}
+	if !containsPrefix(routes, netip.MustParsePrefix("10.1.0.0/16")) {
+		t.Fatalf("expected PrimaryRoute to be present, got %v", routes)
+	}
+}
+
+func ptrSliceView(prefixes []netip.Prefix) *views.Slice[netip.Prefix] {
+	v := views.SliceOf(prefixes)
+	return &v
+}
+
+func containsPrefix(haystack []netip.Prefix, needle netip.Prefix) bool {
+	for _, p := range haystack {
+		if p == needle {
+			return true
+		}
+	}
+	return false
+}
+
 func TestMain(m *testing.M) {
 	log.SetLevel(log.SILENT)
 	os.Exit(m.Run())
